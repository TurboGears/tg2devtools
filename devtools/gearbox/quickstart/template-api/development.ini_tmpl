[DEFAULT]
# Server configuration
server.socket_host = 0.0.0.0
server.socket_port = 8080

# Application configuration
full_stack = true

{{if sqlalchemy}}
# SQLAlchemy configuration (SQLite file for development)
sqlalchemy.url = sqlite:///%(here)s/devdata.db
sqlalchemy.echo = false
{{elif ming}}
# Ming configuration
ming.url = mongodb://localhost:27017/
ming.db = {{package}}
{{endif}}

# Authentication
sa_auth.cookie_secret = {{cookiesecret}}

# Debug mode
debug = true

# Enable debug toolbar if installed
# debugbar.enabled = true

[server:main]
use = egg:gearbox#wsgiref
host = 127.0.0.1
port = 8080

[app:main]
use = egg:{{project}}

# Logging configuration
[loggers]
keys = root, {{package}}{{if auth}}, auth{{endif}}

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = INFO
handlers = console

[logger_{{package}}]
level = DEBUG
handlers =
qualname = {{package}}

{{if auth}}
# A logger for authentication, identification and authorization
# this is repoze.who:
[logger_auth]
level = WARN
handlers =
qualname = auth
{{endif}}

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(asctime)s,%(msecs)03d %(levelname)-5.5s [%(name)s] %(message)s
datefmt = %H:%M:%S
