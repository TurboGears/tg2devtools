# -*- coding: utf-8 -*-
"""Functional tests for API authentication."""

from {{package}}.tests import TestController, setup_database


class TestBearerAuth(TestController):
    """Tests for Bearer token authentication."""

    MANAGER_TOKEN = 'abc123def456ghi789jkl012mno345'

    def setup_method(self, method):
        super().setup_method(method)
        setup_database()
        self._create_manager_user()

    def _create_manager_user(self):
        {{if sqlalchemy}}
        import transaction
        {{endif}}
        from {{package}} import model

        {{if ming}}
        # The in-memory ming datastore persists across tests: reset auth data
        for cls in (model.User, model.Group, model.Permission):
            for obj in cls.query.find().all():
                obj.delete()
        model.DBSession.flush()
        {{endif}}

        group = model.Group()
        group.group_name = 'managers'
        permission = model.Permission()
        permission.permission_name = 'manage'
        {{if sqlalchemy}}
        permission.groups.append(group)
        {{elif ming}}
        permission.groups = [group]
        {{endif}}

        user = model.User()
        user.user_name = 'manager'
        user.display_name = 'Example manager'
        user.email_address = 'manager@somedomain.com'
        user.password = 'managepass'
        user.api_token = self.MANAGER_TOKEN
        {{if sqlalchemy}}
        user.groups.append(group)
        {{elif ming}}
        user.groups = [group]
        {{endif}}

        {{if sqlalchemy}}
        model.DBSession.add(user)
        {{endif}}
        model.DBSession.flush()
        {{if sqlalchemy}}
        # Commit so the request transaction can see the user
        transaction.commit()
        {{endif}}

    def test_bearer_token_authenticates(self):
        response = self.app.get(
            '/demo/admin',
            headers={'Authorization': f'Bearer {self.MANAGER_TOKEN}'},
        )
        assert response.json['user'] == 'manager'
        assert response.json['status'] == 'ok'

    def test_unknown_bearer_token_is_rejected(self):
        self.app.get(
            '/demo/admin',
            headers={'Authorization': 'Bearer not-a-real-token'},
            status=302,
        )

    def test_missing_bearer_token_is_rejected(self):
        self.app.get('/demo/admin', status=302)

    def test_cookie_login_authenticates(self):
        self.app.post(
            '/login_handler',
            {'login': 'manager', 'password': 'managepass'},
        )
        response = self.app.get('/demo/admin')
        assert response.json['user'] == 'manager'


class TestSecurePage(TestBearerAuth):
    """Tests for the protected web page (normal login flow)."""

    def test_login_page_renders(self):
        response = self.app.get('/login')
        assert response.status_int == 200
        assert '<h1>Login</h1>' in response.text

    def test_secure_page_redirects_anonymous_users(self):
        response = self.app.get('/secure', status=302)
        assert '/login' in response.headers['Location']

    def test_secure_page_accessible_after_login(self):
        self.app.post(
            '/login_handler',
            {'login': 'manager', 'password': 'managepass'},
        )
        response = self.app.get('/secure')
        assert 'Example manager' in response.text
