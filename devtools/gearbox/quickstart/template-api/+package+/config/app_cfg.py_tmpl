# -*- coding: utf-8 -*-
"""
Global configuration file for TG2-specific settings in {{project}}.

This file complements development/deployment.ini.

"""
from tg import FullStackApplicationConfigurator

import {{package}}
from {{package}} import model, lib

base_config = FullStackApplicationConfigurator()

# General configuration
base_config.update_blueprint({
    'disable_request_extensions': False,
    'decode_json_params': True,
    'dispatch_path_translator': True,
    'package': {{package}},
})

# Rendering Engines Configuration - API primarily uses JSON
base_config.update_blueprint({
    'renderers': ['json', 'kajiki'],
    'default_renderer': 'kajiki',
    'templating.kajiki.strip_text': False,
})

# Configure Sessions, store data as JSON to avoid pickle security issues
base_config.update_blueprint({
    'session.enabled': True,
    'session.data_serializer': 'json',
})

{{if sqlalchemy}}
# Configure the base SQLALchemy Setup
base_config.update_blueprint({
    'use_sqlalchemy': True,
    'model': {{package}}.model,
    'DBSession': {{package}}.model.DBSession,
})
{{elif ming}}
# Configure the base Ming Setup
base_config.update_blueprint({
    'use_sqlalchemy': False,
    'tm.enabled': False,

    'use_ming': True,
    'model': {{package}}.model,
    'DBSession': {{package}}.model.DBSession,
})
{{else}}
# Disable Ming and SQLAlchemy
base_config.update_blueprint({
    'use_sqlalchemy': False,
    'use_ming': False,
    'tm.enabled': False,
    'auth_backend': None,
})
{{endif}}

{{if auth}}
# This tells to TurboGears how to retrieve the data for your user
from tg.configuration.auth import TGAuthMetadata
{{if auth == "sqlalchemy" or auth == "ming"}}
from zope.interface import implementer
from repoze.who.interfaces import IIdentifier, IAuthenticator


@implementer(IIdentifier)
class BearerTokenIdentifier(object):
    """repoze.who identifier that recognizes the ``Authorization: Bearer`` header."""

    def identify(self, environ):
        auth_header = environ.get('HTTP_AUTHORIZATION', '')
        if auth_header.startswith('Bearer '):
            return {'api_token': auth_header[7:].strip()}

    def remember(self, environ, identity):
        return []

    def forget(self, environ, identity):
        return []


@implementer(IAuthenticator)
class BearerTokenAuthenticator(object):
    """repoze.who authenticator that resolves ``api_token`` identities."""

    def __init__(self, dbsession, user_class):
        self.dbsession = dbsession
        self.user_class = user_class

    def authenticate(self, environ, identity):
        token = identity.get('api_token')
        if not token:
            return None
        {{if sqlalchemy}}
        user = self.dbsession.query(self.user_class).filter_by(api_token=token).first()
        {{elif ming}}
        user = self.user_class.query.get(api_token=token)
        {{endif}}
        if user:
            return user.user_name
        return None


class ApplicationAuthMetadata(TGAuthMetadata):
    def __init__(self, dbsession, user_class):
        self.dbsession = dbsession
        self.user_class = user_class

    def _find_user(self, **criteria):
        {{if sqlalchemy}}
        return self.dbsession.query(self.user_class).filter_by(**criteria).first()
        {{elif ming}}
        return self.user_class.query.get(**criteria)
        {{endif}}

    def authenticate(self, environ, identity):
        # Standard TG username/password auth
        login = identity.get('login')
        password = identity.get('password')

        user = self._find_user(user_name=login)

        if not user:
            login = None
        elif not user.validate_password(password):
            login = None

        if login is None:
            try:
                from urllib.parse import parse_qs, urlencode
            except ImportError:
                from urlparse import parse_qs
                from urllib import urlencode
            from tg.exceptions import HTTPFound

            params = parse_qs(environ['QUERY_STRING'])
            params.pop('password', None)  # Remove password in case it was there
            if user is None:
                params['failure'] = 'user-not-found'
            else:
                params['login'] = identity['login']
                params['failure'] = 'invalid-password'

            # When authentication fails send user to login page.
            environ['repoze.who.application'] = HTTPFound(
                location=environ['SCRIPT_NAME'] + '?'.join(('/login', urlencode(params, True)))
            )

        return login

    def get_user(self, identity, userid):
        return self._find_user(user_name=userid)

    def get_groups(self, identity, userid):
        return [g.group_name for g in identity['user'].groups]

    def get_permissions(self, identity, userid):
        return [p.permission_name for p in identity['user'].permissions]
{{endif}}

# Configure the authentication backend
base_config.update_blueprint({
    'sa_auth.enabled': True,

    # YOU MUST CHANGE THIS VALUE IN PRODUCTION TO SECURE YOUR APP
    'sa_auth.cookie_secret': "{{cookiesecret}}",
    'sa_auth.authmetadata': ApplicationAuthMetadata(model.DBSession, model.User),

    # You may optionally define a page where you want users
    # to be redirected to on login:
    'sa_auth.post_login_url': '/post_login',

    # You may optionally define a page where you want users
    # to be redirected to on logout:
    'sa_auth.post_logout_url': '/post_logout',

    # In case ApplicationAuthMetadata didn't find the user discard the whole identity.
    # This might happen if logged-in users are deleted.
    'identity.allow_missing_user': False,

    # override this if you would like to provide a different who plugin for
    # managing login and logout of your application
    'sa_auth.form_plugin': None,

    # Recognize the ``Authorization: Bearer`` header for API clients
    'sa_auth.identifiers': [('bearer', BearerTokenIdentifier()), ('default', None)],
    'sa_auth.authenticators': [
        ('bearer', BearerTokenAuthenticator(model.DBSession, model.User)),
        ('default', None),
    ],

    # You can use a different repoze.who Authenticator if you want to
    # change the way users can login
    # 'sa_auth.authenticators': [('myauth', SomeAuthenticator())],

    # You can add more repoze.who metadata providers to fetch
    # user metadata.
    # Remember to set 'sa_auth.authmetadata' to None
    # to disable authmetadata and use only your own metadata providers
    # 'sa_auth.mdproviders': [('myprovider', SomeMDProvider())],
})
{{endif}}

try:
    # Enable DebugBar if available, install tgext.debugbar to turn it on
    from tgext.debugbar import enable_debugbar
    enable_debugbar(base_config)
except ImportError:
    pass
