# -*- coding: utf-8 -*-
"""Demo controller."""

from tg import expose, predicates, require, request
from tg.i18n import lazy_ugettext as l_
from {{package}}.lib.base import BaseController


class DemoController(BaseController):
    """Demo controller."""

    @expose('{{package}}.templates.demo.index')
    def index(self, **kw):
        """Show the API demo landing page."""
        return dict(page='index', project='{{package}}', package='{{package}}')

    @expose('json')
    @require(predicates.has_permission('manage', msg=l_('Requires manage permission')))
    def admin(self, **kw):
        """GET /demo/admin - Admin-only endpoint.

        ---
        tags: [demo]
        security:
          - api_token: []
        responses:
          200:
            description: Admin access granted
          403:
            description: Permission denied
        """
        return dict(
            message="Welcome, admin!",
            status="ok",
            user=request.identity['user'].user_name if request.identity else None
        )
