# -*- coding: utf-8 -*-
"""Main Controller for {{project}} API."""

from tg import expose, flash, request, lurl
from tg.exceptions import HTTPFound
{{if auth}}
from tg.i18n import ugettext as _, lazy_ugettext as l_
{{endif}}

from {{package}}.lib.base import BaseController
from {{package}}.controllers.api import APIController
from {{package}}.controllers.demo import DemoController


__all__ = ['RootController']


class RootController(BaseController):
    """The root controller for the {{project}} application."""

    api = APIController()
    demo = DemoController()

    @expose('{{package}}.templates.index')
    def index(self, **kw):
        """API demo landing page."""
        return dict(page='index', project='{{package}}', package='{{package}}')

{{if auth == "sqlalchemy" or auth == "ming"}}

    @expose('{{package}}.templates.login')
    def login(self, came_from=lurl('/'), failure=None, login=''):
        """Start the user login."""
        if failure is not None:
            if failure == 'user-not-found':
                flash(_('User not found'), 'error')
            elif failure == 'invalid-password':
                flash(_('Invalid Password'), 'error')

        login_counter = request.environ.get('repoze.who.logins', 0)
        if failure is None and login_counter > 0:
            flash(_('Wrong credentials'), 'warning')

        return dict(page='login', login_counter=str(login_counter),
                    came_from=came_from, login=login, failure=failure,
                    project='{{package}}')

    @expose()
    def post_login(self, came_from=lurl('/')):
        """
        Redirect the user to the initially requested page on successful
        authentication or redirect her back to the login page if login failed.
        """
        if not request.identity:
            login_counter = request.environ.get('repoze.who.logins', 0) + 1
            redirect('/login',
                     params=dict(came_from=came_from, __logins=login_counter))
        user = request.identity['user']
        flash(_('Welcome back, {}!').format(user.user_name))

        # Do not use tg.redirect with tg.url as it will add the mountpoint
        # of the application twice.
        return HTTPFound(location=came_from)

    @expose()
    def post_logout(self, came_from=lurl('/')):
        """
        Redirect the user to the initially requested page on logout and say
        goodbye as well.
        """
        flash(_('We hope to see you soon!'))
        return HTTPFound(location=came_from)
{{endif}}
