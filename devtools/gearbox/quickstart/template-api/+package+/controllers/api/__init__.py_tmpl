# -*- coding: utf-8 -*-
"""API controllers for {{project}}."""

import json

from markupsafe import Markup
from tg import expose, url
from tgext.apispec.openapi import get_spec
from {{package}}.lib.base import BaseController
{{if (sqlalchemy or ming) and not minimal}}
from .movies import Movie, MoviesController
{{elif not minimal}}
from .movies import MoviesController
{{endif}}


class APIController(BaseController):
    """API root controller."""

{{if not minimal}}
    movies = MoviesController()
{{endif}}

    @expose('json')
    def openapi(self):
        """GET /api/openapi.json - OpenAPI schema."""
        return self._openapi_schema()

    @expose('{{package}}.templates.api_docs')
    def docs(self):
        """GET /api/docs - Redoc API documentation."""
        return dict(schema=Markup(json.dumps(self._openapi_schema(), indent=2)))

    @expose('json')
    def index(self):
        """API root endpoint."""
        return dict(
            name="{{package}} API",
            version="1.0.0",
            description="API server for {{project}}",
            endpoints={
{{if not minimal}}
                "movies": "/api/movies",
{{endif}}
                "openapi": "/api/openapi.json",
                "docs": "/api/docs"
            }
        )

    def _openapi_schema(self):
        """Build the public API schema for Redoc and OpenAPI clients."""
        schema = get_spec(self, prefix=url('/api')).to_dict()
        {{if (sqlalchemy or ming) and not minimal}}
        schema['components']['schemas']['Movie'] = Movie.__API_SCHEMA__
        {{endif}}
        schema['servers'] = [{'url': '/'}]
        schema['paths'].pop(url('/api/openapi'), None)
        return schema
