# -*- coding: utf-8 -*-
"""REST controller for movies."""

from tg import abort, expose, response, validate, validation_errors_response
from tg.controllers import RestController
{{if sqlalchemy}}
from {{package}}.model import DBSession
from {{package}}.model.movie import Movie
{{elif ming}}
from bson import ObjectId
from {{package}}.model import DBSession
from {{package}}.model.movie import Movie
{{endif}}


class MoviesController(RestController):
    """REST controller for movies."""

    @expose('json')
    def get_all(self, **kw):
        """Return the movies available in the catalog.

        Each movie includes its title, release year, and description.

        ---
        tags: [movies]
        responses:
          200:
            description: List of all movies
            content:
              application/json:
                schema:
                  type: object
                  required: [movies]
                  properties:
                    movies:
                      type: array
                      items:
                        $ref: '#/components/schemas/Movie'
        """
        {{if sqlalchemy}}
        movies = DBSession.query(Movie).all()
        {{elif ming}}
        movies = Movie.query.find().all()
        {{else}}
        movies = []
        {{endif}}
        return dict(movies=movies)

    @expose('json')
    @validate(error_handler=validation_errors_response)
    def post(self, title: str, year: int = None, description: str = None, **kw):
        """Add a movie to the catalog.

        A title is required; the release year and description are optional.

        ---
        tags: [movies]
        responses:
          201:
            description: Movie created
          422:
            description: Validation error
        """
        {{if sqlalchemy}}
        movie = Movie(title=title, year=year, description=description)
        DBSession.add(movie)
        DBSession.flush()
        response.status_int = 201
        return dict(movie=movie)
        {{elif ming}}
        movie = Movie(title=title, year=year, description=description)
        DBSession.flush()
        response.status_int = 201
        return dict(movie=movie)
        {{else}}
        response.status_int = 201
        return dict(movie={'title': title, 'year': year, 'description': description})
        {{endif}}

    @expose('json')
    def get_one(self, movie_id, **kw):
        """Return one movie from the catalog.

        Use the movie identifier returned by the catalog endpoint.

        ---
        tags: [movies]
        responses:
          200:
            description: Movie details
            content:
              application/json:
                schema:
                  type: object
                  required: [movie]
                  properties:
                    movie:
                      $ref: '#/components/schemas/Movie'
          404:
            description: Movie not found
        """
        {{if sqlalchemy}}
        movie = DBSession.get(Movie, movie_id)
        {{elif ming}}
        movie = Movie.query.get(_id=ObjectId(movie_id))
        {{else}}
        movie = None
        {{endif}}
        if not movie:
            abort(404, "Movie not found")
        return dict(movie=movie)

    @expose('json')
    @validate(error_handler=validation_errors_response)
    def put(self, movie_id, title: str, year: int = None, description: str = None, **kw):
        """Update a movie's catalog details.

        Supply the title and any changed release year or description.

        ---
        tags: [movies]
        responses:
          200:
            description: Movie updated
          404:
            description: Movie not found
          422:
            description: Validation error
        """
        {{if sqlalchemy}}
        movie = DBSession.get(Movie, movie_id)
        {{elif ming}}
        movie = Movie.query.get(_id=ObjectId(movie_id))
        {{else}}
        movie = None
        {{endif}}
        if not movie:
            abort(404, "Movie not found")
        movie.title = title
        movie.year = year
        movie.description = description
        DBSession.flush()
        return dict(movie=movie)

    @expose('json')
    def post_delete(self, movie_id, **kw):
        """Remove a movie from the catalog.

        The deleted movie is no longer returned by catalog requests.

        ---
        tags: [movies]
        responses:
          200:
            description: Movie deleted
          404:
            description: Movie not found
        """
        {{if sqlalchemy}}
        movie = DBSession.get(Movie, movie_id)
        {{elif ming}}
        movie = Movie.query.get(_id=ObjectId(movie_id))
        {{else}}
        movie = None
        {{endif}}
        if not movie:
            abort(404, "Movie not found")
        {{if sqlalchemy}}
        DBSession.delete(movie)
        {{elif ming}}
        movie.delete()
        DBSession.flush()
        {{endif}}
        return dict(status='deleted', movie_id=movie_id)

