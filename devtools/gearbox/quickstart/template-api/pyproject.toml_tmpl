[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{name}}"
version = "0.0.1"
description = "{{project}} API server"
requires-python = ">=3.10"
readme = { file = "README.rst", content-type = "text/x-rst" }
keywords = ["turbogears", "api", "rest"]
classifiers = []
authors = [
    { name = "TurboGears Team", email = "turbogears@groups.google.com" }
]
license = { text = "MIT" }
urls = { Homepage = "http://www.turbogears.org" }
dependencies = [
    "TurboGears2 >= 2.5.1",
    "tgext.apispec",
    "kajiki",
    "sqlalchemy",
]

[project.optional-dependencies]
testing = [
    "webtest",
    "pytest",
]

[tool.setuptools.packages.find]
exclude = ["ez_setup", "examples", "tests"]

[tool.setuptools]
include-package-data = true
zip-safe = false
