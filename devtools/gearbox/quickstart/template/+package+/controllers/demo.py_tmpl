# -*- coding: utf-8 -*-
"""Small generated demo controller."""

from tg import expose, request, tmpl_context, validate
{{if auth}}
from tg import predicates, require
from tg.i18n import lazy_ugettext as l_
{{endif}}

from {{package}}.lib.base import BaseController
{{if sqlalchemy}}
from {{package}}.model import DBSession
from {{package}}.model.todo import TodoItem
{{endif}}

__all__ = ['DemoController']


class DemoController(BaseController):
    """A tiny server-rendered demo that is safe to delete."""

    def _before(self, *args, **kw):
        tmpl_context.project_name = "{{package}}"

    @expose('{{package}}.templates.demo.index')
    def index(self, **kw):
        """Show the demo landing page."""
        return self._todo_data()

{{if sqlalchemy}}

    @expose('{{package}}.templates.demo.todo_list')
    def todos(self, **kw):
        """Render the todo fragment after htmx updates or validation errors."""
        validation = getattr(request, 'validation', None)
        return self._todo_data(
            values=getattr(validation, 'values', {}) or kw,
            errors=getattr(validation, 'errors', {}),
        )

    @expose('{{package}}.templates.demo.todo_list')
    @validate(error_handler=todos)
    def add(self, title: str):
        """Store a todo item using TurboGears type-hint validation."""
        DBSession.add(TodoItem(title=title))
        return self._todo_data()

    @expose('{{package}}.templates.demo.todo_list')
    @validate(error_handler=todos)
    def toggle(self, todo_id: int, done: bool = False):
        """Toggle a todo item using TurboGears bool conversion."""
        item = DBSession.query(TodoItem).filter_by(id=todo_id).first()
        if item is not None:
            item.done = done
        return self._todo_data()
{{endif}}

{{if auth}}

    @expose('{{package}}.templates.demo.protected')
    @require(predicates.has_permission('manage', msg=l_('Only for managers')))
    def protected(self):
        """Show a tiny protected page when auth is enabled."""
        return dict(page='demo')
{{endif}}

{{if sqlalchemy}}

    def _todo_data(self, values=None, errors=None):
        return dict(
            page='demo',
            has_todos=True,
            todos=DBSession.query(TodoItem).order_by(TodoItem.id).all(),
            values=values or {},
            errors=errors or {},
        )
{{else}}

    def _todo_data(self):
        return dict(page='demo', has_todos=False)
{{endif}}
